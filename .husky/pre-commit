#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks..."

# Typecheck client
cd client && npm run typecheck
if [ $? -ne 0 ]; then
  echo "Client typecheck failed. Commit aborted."
  exit 1
fi

# Typecheck server
cd ../server && npm run typecheck
if [ $? -ne 0 ]; then
  echo "Server typecheck failed. Commit aborted."
  exit 1
fi

echo "All checks passed!"
